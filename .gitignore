.env
.env.*
!.env.example
*.env
*.pem
*.key
*.crt
*.pfx
*.p12
cookies.txt
token.json
credentials.json
service_account*.json

# ==============================================================================
# Runtime State, Process PIDs & Sockets
# ==============================================================================
data/run/*
!data/run/.gitkeep
*.pid
*.sock

# ==============================================================================
# Logs & Audit Trails
# ==============================================================================
*.log
data/logs/*
!data/logs/.gitkeep
data/audit.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

