# ==============================================================================
# PDF QA Agent - Environment Configuration
# ==============================================================================

# Toggle Gemini API integration:
# Set to 'true' to enable Gemini LLM extraction, solving, and vision OCR.
# Set to 'false' to run 100% offline using:
#   - Local Malayalam font mapping & SMC transliteration
#   - Offline Tesseract mathematical OCR
#   - Fast local regex question parsing
#   - Official examination answer-key validation
ENABLE_GEMINI=true

# Google Gemini API Key (Required ONLY when ENABLE_GEMINI=true)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Toggle Groq API integration:
# Set to 'true' to enable Groq LLM extraction and solving.
ENABLE_GROQ=false

# Groq API Key (Required when ENABLE_GROQ=true)
# Obtain from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Optional - defaults to qwen/qwen3.8-27b for multimodal vision + text)
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_SOLVE_MODEL=qwen/qwen3.8-27b

# Toggle AI Answer Solving & Validation:
# Set to 'true' to solve questions with LLM and verify against the marked answer key.
# Set to 'false' to skip AI answer validation (faster processing, $0 solving token cost).
ENABLE_ANSWER_VALIDATION=true

# Database URL (Optional - defaults to SQLite in data/ directory if not provided)
# Local default: sqlite:///./data/pdf_qa.db
# Docker default: sqlite:////app/pdf_qa_agent/data/pdf_qa.db
# SQLALCHEMY_DATABASE_URL=sqlite:///./data/pdf_qa.db

# Gemini Models
# GEMINI_EXTRACT_MODEL=gemini-3.1-flash-lite
# GEMINI_SOLVE_MODEL=gemini-3.1-pro-preview
